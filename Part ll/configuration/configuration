Configuration Steps
 
! Enable IPv6 routing
enbale
conf t(configure terminal)
ipv6-unicast routing

! Interface to Router 2
interface GigabitEthernet0/0
ipv6 address 2000:bad:cafe:1::1/64
ipv6 address fe80::1 link-local
no shutdown


! Interface to Router3
enable
conf t
interface GigabitEthernet0/1
ipv6 address 2000:bad:cafe:2::1/64
ipv6 address fe80::2 link-local
no shutdown

! Interface between router 2 and router 3 (router 3 side)
int g0/0
ipv6 address 2000:bad:cafe:2::2/64
ipv6 address fe80::2 link-local
no shutdown

! Interface between router 2 and router 3 (router 2 side)
int g0/0
ipv6 address 2000:bad:cafe:2::1/64
ipv6 address fe80::1 link-local
no shutdown

! Configure eigrp(Router 2) 
enable 
conf t
ipv6 router eigrp 10
eigrp router-id 1.1.1.1
no shutdown
passive-interface g0/1

! Configure eigrp(Router 3)
enable 
conf t
ipv6 router eigrp 10
eigrp router-id 2.2.2.2
no shutdown
passive-interface g0/1

! Configure cables parcitipate eigrp communication (Router 3)
int g0/0
ipv6 eigrp 10

int g0/1
ipv6 eigrp 10

! Configure cables parcitipate eigrp communication (Router2 )
int g0/0
ipv6 eigrp 10

int g0/1
ipv6 eigrp 10

