! Switch Configuration
vlan 10
 name STUDENTS
vlan 20
 name ADMIN
vlan 30
 name GUEST
vlan 40
 name SERVERS

! Configure Trunk link on 2960-24TT
enable
configure terminal
interface fastEthernet0/22-0/24
switchport mode trunk
switchport trunk allowed vlan 10,20,40
no shutdown
end
write memory

! Configure Subinterface on the router
enable
configure terminal

! VLAN 10
interface gig0/0.10
encapsulation dot1Q 10
ip address 192.168.10.1 255.255.255.0
exit

